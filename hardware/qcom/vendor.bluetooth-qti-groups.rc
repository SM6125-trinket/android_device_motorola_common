# Override AOSP android.hardware.bluetooth@1.0-service groups to match QTI
# passthrough implementation (android.hardware.bluetooth@1.0-impl-qti.so).
service vendor.bluetooth-1-0 /vendor/bin/hw/android.hardware.bluetooth@1.0-service
    override
    interface android.hardware.bluetooth@1.0::IBluetoothHci default
    class hal
    capabilities BLOCK_SUSPEND NET_ADMIN SYS_NICE
    user bluetooth
    group bluetooth system wakelock oem_2901 net_raw
    task_profiles HighPerformance
