firmware_directories /vendor/firmware_mnt/image/

# GPU / ION / Display
/dev/kgsl-3d0             0666   root       root
/dev/ion                  0666   root       system
/dev/msm_hdcp             0660   system     graphics
/dev/mdss_rotator         0664   system     graphics

# FastRPC / QSEECOM / Crypto / Sensors / Subsystems
/dev/adsprpc-smd          0666   system     system
/dev/adsprpc-smd-secure   0666   system     system
/dev/qseecom              0660   system     drmrpc
/dev/qce                  0660   system     drmrpc
/dev/sensors              0660   system     system
/dev/iio:device*          0660   system     system
/dev/subsys_*             0640   root       system
/dev/rtc0                 0660   system     system

# Fuel gauge (QTI QG / hvdcp_opti)
/dev/qg                   0660   system     system
/dev/qg_battery           0660   system     system

# Camera / Video / JPEG
/dev/video*               0660   system     camera
/dev/media*               0660   system     camera
/dev/v4l-subdev*          0660   system     camera
/dev/jpeg*                0660   system     camera

# Audio / Sound
/dev/apr_apps2            0660   system     audio
/dev/avtimer              0660   system     audio
/dev/msm_aac*             0660   system     audio
/dev/msm_acdb             0660   system     audio
